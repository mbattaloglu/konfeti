{
  "name": "konfeti",
  "version": "0.2.0",
  "description": "Zero-dependency, strictly typed, highly customizable canvas confetti with emoji, text, image and spritesheet particles.",
  "license": "MIT",
  "author": "mbattaloglu",
  "homepage": "https://konfeti.mbattaloglu.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbattaloglu/konfeti.git",
    "directory": "packages/konfeti"
  },
  "bugs": {
    "url": "https://github.com/mbattaloglu/konfeti/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs",
    "./dist/konfeti.iife.js",
    "./dist/konfeti.worker.js",
    "./dist/worker.js",
    "./dist/worker.cjs",
    "./src/index.ts",
    "./src/workerEntry.ts"
  ],
  "keywords": [
    "confetti",
    "canvas",
    "particles",
    "emoji",
    "sprite",
    "animation",
    "celebration",
    "typescript"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./lite": {
      "import": {
        "types": "./dist/lite.d.ts",
        "default": "./dist/lite.js"
      },
      "require": {
        "types": "./dist/lite.d.cts",
        "default": "./dist/lite.cjs"
      }
    },
    "./worker": {
      "import": {
        "types": "./dist/worker.d.ts",
        "default": "./dist/worker.js"
      },
      "require": {
        "types": "./dist/worker.d.cts",
        "default": "./dist/worker.cjs"
      }
    },
    "./konfeti.worker.js": "./dist/konfeti.worker.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/konfeti.iife.js",
  "jsdelivr": "./dist/konfeti.iife.js",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.tr.md"
  ],
  "scripts": {
    "build": "node scripts/build-worker.mjs && tsdown && cp src/worker/generated/konfeti.worker.js dist/konfeti.worker.js",
    "prepublishOnly": "npm run build",
    "typecheck": "node scripts/build-worker.mjs && tsc --noEmit -p tsconfig.json",
    "test": "node scripts/build-worker.mjs && vitest run",
    "docs": "typedoc",
    "build:worker": "node scripts/build-worker.mjs"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "rolldown": "1.2.11",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.20",
    "vitest": "^5.0.2",
    "vitest-canvas-mock": "^1.2.0"
  }
}
